---
import '../styles/global.css';

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Richard Cook – Software Engineer" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <div class="container">
        <a href="/" class="brand">Richard Cook</a>
        <nav>
          <a href="/">Home</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer>
      <div class="container">
        <span>© <span id="year"></span> Richard Cook</span>
        <div class="socials">
          <a href="https://github.com/richardcookuk" target="_blank" rel="noopener">GitHub</a>
          <a href="https://linkedin.com/in/richardcookuk" target="_blank" rel="noopener">LinkedIn</a>
          <a href="mailto:richard@example.com">Email</a>
        </div>
      </div>
    </footer>

    <script>
      const yearEl = document.getElementById('year');
      if (yearEl) {
        yearEl.textContent = String(new Date().getFullYear());
      }
    </script>
  </body>
</html>
